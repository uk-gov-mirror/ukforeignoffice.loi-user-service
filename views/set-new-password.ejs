<% pageTitle = "Set a new password - Get a document legalised – GOV.UK" %>

<%if(error){
pageTitle = "Error: Set new password - Get a document legalised – GOV.UK"
} %>

<%- include('partials/header.ejs') %>

<% if (error) { %>
  <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" aria-labelledby="error-summary-heading-example-2" tabindex="-1" autofocus>
    <h2 class="govuk-error-summary__title" id="error-summary-heading-example-2">
      There is a problem
    </h2>
    <ul class="govuk-list govuk-error-summary__list">
      <%if (error) {error.forEach(function(msg){%>
        <%if (passwordErrorType.toString().includes("phraselist") && (passwordErrorType.toString().includes("blacklist"))){%>
          <li><a id="bothlists" href="#legend_password"><%= msg %></a></li>
        <%} else if (passwordErrorType.toString().includes("phraselist")){%>
            <li><a id="phraselist" href="#legend_password"><%= msg %></a></li>
          <%} else if (passwordErrorType.toString().includes("blacklist")){%>
              <li><a id="blacklist" href="#legend_password"><%= msg %></a></li>
            <%} else { %>
                <li><a href="#legend_password"><%= msg %></a></li>
              <%}%>
              <%})
              }%>
            </ul>
          </div>
        <% } %>
        <h1 class="heading-xlarge">Set a new password</h1>

        <div >
          <p>Your password has expired and you need to create a new one. Your new password must be different from your last password.</p>

          <form action="/api/user/set-new-password?_csrf=<%=_csrf%>" method="post" id="password-reset">
          <div class="govuk-form-group <% if (error) { %>govuk-form-group--error<% } %>" id="legend_password">
          <label for="password" class="govuk-label govuk-label--s">New password</label>
          <p class="govuk-hint">Minimum 8 characters, including 1 uppercase letter, 1 number and 1 special character (e.g. !, @, #)</p>
          <input class="govuk-input govuk-!-width-one-half <% if (error) { %>govuk-input--error<% } %>" id="password" name="password" aria-required="true" type="password" >
        </div>
        <div class="govuk-form-group <% if (error) { %>govuk-form-group--error<% } %>">
        <label for="confirm_password" class="govuk-label govuk-label--s">Confirm password</label>
        <input class="govuk-input govuk-!-width-one-half <% if (error) { %>govuk-input--error<% } %>" id="confirm_password" name="confirm_password" aria-required="true" type="password" >
      </div>
      <input type="submit" class="button" value="Update password">
    </form>

  </div>

  <%- include('partials/footer.ejs') %>
