<% pageTitle = "Manage user permissions - Get a document legalised – GOV.UK" %>

<%if(error){
pageTitle = "Error: Manage user permissions - Get a document legalised – GOV.UK"
} %>

<%- include('../partials/header.ejs') %>

<% if (info.length > 0) { %>
  <div class="alert alert--success" role="alert"><p class="alert__message"><%= info %></p></div>
<% } %>

<% if (error) { %>
  <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" aria-labelledby="error-summary-title" tabindex="-1" autofocus>
    <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
    <div class="govuk-error-summary__body">
      <ul class="govuk-list govuk-error-summary__list">
        <li><a href="#search-email"><%= error %></a></li>
      </ul>
    </div>
  </div>
<% } %>

<h1 class="heading-xlarge">Manage user permissions</h1>

<div >

  <form action="/api/user/admin-search-email?_csrf=<%=_csrf%>" method="post" id="search-form">
  <div class="govuk-form-group <% if (error) { %>govuk-form-group--error<% } %>" style="position: relative;">
  <label class="govuk-label govuk-label--s" for="search-email">Find a user by email</label>
  <% if (error) { %>
    <p id="search-email-error" class="govuk-error-message">
      <span class="govuk-visually-hidden">Error:</span> <%= error %>
    </p>
  <% } %>
  <input class="govuk-input <% if (error) { %>govuk-input--error<% } %>" id="search-email" name="searchEmail" type="email" autocomplete="off" <% if (error) { %>aria-describedby="search-email-error"<% } %>>

  <!-- Custom styled dropdown instead of <datalist> -->
  <div id="email-suggestions-container"></div>
</div>
<button class="govuk-button" type="submit">Search user</button>
</form>

</div>
<script src="/api/user/js/admin-section.js?v=<%= locals.cacheBust || '' %>"></script>
<%- include('../partials/footer.ejs') %>
