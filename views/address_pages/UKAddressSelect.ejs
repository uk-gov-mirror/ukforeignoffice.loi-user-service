<% pageTitle ="Add a return address - Get a document legalised – GOV.UK" %>

<%if(error_report && error_report.length>0){
pageTitle = "Error: Add a return address - Get a document legalised – GOV.UK"
} %>

<% locals.innerHeaderBackLink = '/api/user/add-address' %>
<%- include('../partials/header.ejs') %>

<%if (error_report && error_report.length>0) {%>
  <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" aria-labelledby="error-summary-title" tabindex="-1" autofocus>
    <h2 class="govuk-error-summary__title" id="error-summary-title">
      <%if (typeof error_heading !== 'undefined' && error_heading !== ''){%>
        <%= error_heading %>
      <%}else{%>
        There is a problem
      <%}%>
    </h2>
    <div class="govuk-error-summary__body">
      <ul class="govuk-list govuk-error-summary__list">
        <%if (typeof error_heading !== 'undefined' && error_heading !== ''){%>
          <li><a href="/api/user/your-address-manual"><%= error_report%></a></li>
        <%}else{%>
          <li><a href="#find-postcode"><%= error_report%></a></li>
        <%}%>
      </ul>
    </div>
  </div>
<%}%>
    <h1 class="heading-xlarge">Add a return address</h1>

    <div class="govuk-form-group <%if (error_report && error_report.length>0) {%>govuk-form-group--error<%}%>">
    <form id="find-address-form" method="post" action="/api/user/find-your-address?_csrf=<%=_csrf%>">
    <label class="govuk-label govuk-label--s" for="find-postcode">Enter postcode</label>
    <% if(error_report && error_report.length>0){%>
      <p id="postcode-inline-error" class="govuk-error-message">
        <span class="govuk-visually-hidden">Error:</span> <%= error_report%>
      </p>
    <%}%>

    <input class="govuk-input govuk-!-width-one-quarter<% if(error_report && error_report.length>0){%> govuk-input--error<%}%>" id="find-postcode" aria-required="true" type="text" value="<%= postcode%>" name="find-postcode" <% if(error_report && error_report.length>0){%>aria-describedby="postcode-inline-error"<%}%>>
    <button class="govuk-button" data-csrf="<%=_csrf%>" type="submit" id="find-address">Find UK address</button>
  </form>
  <a class="link address-manual" id="address-manual" href="<%= '/api/user/your-address-manual'%>" >Enter address manually</a>

  <form id="select-address-form" method="post" action="/api/user/select-your-address?_csrf=<%=_csrf%>">
  <input type="hidden" name="full_name" value="<%if(account.full_name != null){%><%= account.full_name %><%}%>">
  <input type="hidden" name="postcode" value="<%= postcode%>">
  <div class="<%if(addresses.length==0 || addresses==false){%>hide<%}%>" id="address-list-group">
  <label class="form-label visuallyhidden" for="form-select">Pick an address</label>
  <select class="govuk-input govuk-!-width-one-half" data-csrf="<%=_csrf%>" id="address-list-box" name="address" form="select-address-form" aria-required="true"
  onchange="document.getElementById('select-address-form').submit();">
  <option disabled selected>Pick an address</option>
  <%for(var a=0; a<addresses.length; a++){%>
    <option value=<%= addresses[a].id%> ><%= addresses[a].text %></option>
  <%}%>
</select>
<button class="govuk-button govuk-button--secondary js-hidden <%if(addresses.length==0){%>hide<%}%>" type="submit" id="select-address">Select Address</button>

</div>

</form>
</div>

<%- include('../partials/footer.ejs') %>
