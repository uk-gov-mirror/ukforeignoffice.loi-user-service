<%var primaryAddressErrors = [];
if (error_report) {
if (error_report[0][0].errMsgs) {
error_report[0][0].errMsgs.forEach(
function(error){
if (error.fieldName == "full_name") {
primaryAddressErrors.push(error);
}
if (error.fieldName == "postcode") {
primaryAddressErrors.push(error);
}
if (error.fieldName == "house_name") {
primaryAddressErrors.push(error);
}
if (error.fieldName == "street") {
primaryAddressErrors.push(error);
}
if (error.fieldName == "town") {
primaryAddressErrors.push(error);
}
if (error.fieldName == "county") {
primaryAddressErrors.push(error);
}
if (error.fieldName == "telephone") {
primaryAddressErrors.push(error);
}
if (error.fieldName == "mobileNo") {
primaryAddressErrors.push(error);
}
if (error.fieldName == "email") {
primaryAddressErrors.push(error);
}

}
)
}

}%>
<% pageTitle ="Add a return address - Get a document legalised – GOV.UK" %>

<%if(error_report && error_report.length>0){
pageTitle = "Error: Add a return address - Get a document legalised – GOV.UK"
} %>
<% locals.innerHeaderBackLink = '/api/user/add-address-uk' %>
<%- include('../partials/header.ejs') %>

<%if(error_report.length>0){%><br>
<%}%>
<div autofocus class="govuk-error-summary <% if (error_report) { %>show<% } else { %>hide<% } %>" role="alert" aria-labelledby="error-summary-heading-example-2" tabindex="-1" style="clear:left;">

<h2 class="govuk-error-summary__title" id="error-summary-heading">
  There is a problem
</h2>

<div id="all-errors">
  <ul class="govuk-list govuk-error-summary__list">
    <% if (error_report) { %>
      <% error_report[0][0].errMsgs.forEach( function(errorMsgs) { %>
        <li>
          <a href="<%= errorMsgs.questionId === 'town-county' ? '#' + 'town' : '#' + errorMsgs.questionId %>">
          <%= errorMsgs.fieldSolution %>
        </a>
      </li>
    <% }) %>
  <% } %>
</ul>
</div>
</div>
<h1 class="heading-xlarge">Add a return address</h1>

<div class="govuk-form-group">

  <form id="find-address-form" method="post" action="/api/user/find-your-address?_csrf=<%=_csrf%>">
  <label class="govuk-label govuk-label--s" for="find-postcode">Enter postcode</label>
  <input class="govuk-input govuk-!-width-one-quarter" id="find-postcode" type="text" aria-required="true" value="<%= postcode%>" name="find-postcode">
  <button class="govuk-button" data-csrf="<%=_csrf%>" type="submit" id="find-address">Find UK address</button>
</form>
<a class="link address-manual" id="address-manual" href="<%= '/api/user/your-address-manual'%>" >Enter address manually</a>

<form id="select-address-form" method="post" action="/api/user/select-your-address?_csrf=<%=_csrf%>">
<input type="hidden" name="full_name" value="<%if(account.full_name != null){%><%= account.full_name %><%}%>">
<input type="hidden" name="postcode" value="<%= postcode%>">
<div class="<%if(addresses.length==0 || addresses==false){%>hide<%}%>" id="address-list-group">
<label class="form-label visuallyhidden" for="address-list">Pick an address</label>
<select class="govuk-input govuk-!-width-one-half" data-csrf="<%=_csrf%>" aria-required="true" id="address-list-box" name="address" form="select-address-form"
onchange="document.getElementById('select-address-form').submit();">
<option disabled selected>Pick an address</option>
<%for(var a=0; a<addresses.length; a++){%>
  <option value=<%= addresses[a].id%> <%if(addresses[a].id==chosen_address){%>selected<%}%>><%= addresses[a].text %></option>
<%}%>
</select>
<button class="govuk-button govuk-button--secondary js-hidden <%if(addresses.length==0){%>hide<%}%>" type="submit" id="select-address">Select Address</button>

</div>

</form>
</div>

<form id="address_form" method="post" action="/api/user/save-address?_csrf=<%=_csrf%>">
<div class="govuk-form-group address-form" id="address-details-group">

  <div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('full_name')>-1) { %>error<% } %>" id="legend_full_name">
  <label class="govuk-label govuk-label--s" for="full-name">Full name</label>
  <span class="govuk-hint">Name of the person you would like the documents returned to</span><span class="error-message">
    <% if (error_report && primaryAddressErrors.length>0) { %>
      <% primaryAddressErrors.forEach( function(errorItem) { %>
        <% if (errorItem.questionId == "full_name") { %>
          <%= errorItem.fieldError %>
        <% } %>
      <% }) %>
    <% } %>
  </span>
  <input class="govuk-input govuk-!-width-one-half" id="full_name" type="text" aria-required="true" name="full_name" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].full_name%><%} else if (form_values) { %><%= form_values.full_name %><% } %>">

</div>
<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('organisation')>-1) { %>error<% } %>" id="legend_organisation">
<label class="govuk-label govuk-label--s" for="organisation">Company or organisation (optional)</label><span class="error-message">
  <% if (error_report && primaryAddressErrors.length>0) { %>
    <% primaryAddressErrors.forEach( function(errorItem) { %>
      <% if (errorItem.questionId == "organisation") { %>
        <%= errorItem.fieldSolution %>
      <% } %>
    <% }) %>
  <% } %>
</span>

<input class="govuk-input govuk-!-width-one-half" id="organisation" type="text" name="organisation" aria-required="true" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].organisation%><%} else if (form_values) { %><%= form_values.organisation %><% } %>" >
</div>

<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('house_name')>-1) { %>error<% } %>" id="legend_house_name">
<label class="govuk-label govuk-label--s" for="house_name">House name or number</label><span class="error-message">
  <% if (error_report && primaryAddressErrors.length>0) { %>
    <% primaryAddressErrors.forEach( function(errorItem) { %>
      <% if (errorItem.questionId == "house_name") { %>
        <%= errorItem.fieldError %>
      <% } %>
    <% }) %>
  <% } %>
</span>

<input class="govuk-input govuk-!-width-one-half" id="house_name" type="text" aria-required="true" maxlength="255" name="house_name" value="<%if(form_values && form_values.house_name && form_values.house_name != 'N/A') { %><%= form_values.house_name %><% } %>" >
</div>

<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('street')>-1) { %>error<% } %>" id="legend_street">
<label class="govuk-label govuk-label--s" for="street">Street</label><span class="error-message">
  <% if (error_report && primaryAddressErrors.length>0) { %>
    <% primaryAddressErrors.forEach( function(errorItem) { %>
      <% if (errorItem.questionId == "street") { %>
        <%= errorItem.fieldError %>
      <% } %>
    <% }) %>
  <% } %>
</span>

<input class="govuk-input govuk-!-width-one-half" type="text" aria-required="true" maxlength="255" id="street" name="street" value="<%if(form_values[0]){%><%= form_values[0].street%><%} else if (form_values) { %><%= form_values.street %><% } %>" >
</div>

<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('town-county')>-1) { %>error<% } %>" id="town-county">
<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('town')>-1) { %>error<% } %>" id="legend_town">
<label class="govuk-label govuk-label--s" for="town">Town</label><input class="govuk-input govuk-!-width-one-half" type="text" aria-required="true" maxlength="255" id="town" name="town" value="<%if(form_values[0]){%><%= form_values[0].town%><%} else if (form_values) { %><%= form_values.town %><% } %>" >
</div>

<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('county')>-1) { %>error<% } %>" id="legend_county">
<label class="govuk-label govuk-label--s" for="county">County <span>(optional)</span></label><input class="govuk-input govuk-!-width-one-half" type="text" id="county" name="county" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].county%><%} else if (form_values) { %><%= form_values.county %><% } %>">
</div>
</div>

<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('postcode')>-1) { %>error<% } %>" id="legend_postcode">
<label class="govuk-label govuk-label--s" for="postcode">Postcode</label><input class="govuk-input govuk-!-width-one-quarter" aria-required="true" id="postcode" name="postcode" type="text" value="<%if(form_values[0]){%><%= form_values[0].postcode%><%} else if (form_values) { %><%= form_values.postcode %><% } %>" >
</div>
<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('mobileNo')>-1) { %>error<% } %>" id="legend_mobileNo">
<label class="govuk-label govuk-label--s" for="mobileNo">Mobile number</label>
<span class="govuk-hint">Mobile number for this address for delivery questions or updates</span><input class="govuk-input govuk-!-width-one-half" type="tel" id="mobileNo" name="mobileNo" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].mobileNo || '' %><%} else if (form_values) { %><%= form_values.mobileNo || '' %><% } else {%><%= contact_mobileNo %><%}%>">
</div>
<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('telephone')>-1) { %>error<% } %>" id="legend_telephone">
<label class="govuk-label govuk-label--s" for="telephone">Secondary phone number <span>(optional)</span></label>
<span class="govuk-hint">Land line number for this address for delivery questions or updates</span><input class="govuk-input govuk-!-width-one-half" type="tel" id="telephone" aria-required="true" name="telephone" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].telephone%><%} else if (form_values) { %><%= form_values.telephone %><% } else {%><%= contact_telephone %><%}%>">
</div>
<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('email')>-1) { %>error<% } %>" id="legend_email">
<label class="govuk-label govuk-label--s" for="email">Email address <span>(optional)</span></label>
<span class="govuk-hint">Contact email for this address for delivery questions or updates</span><input class="govuk-input govuk-!-width-one-half" type="text" id="email" name="email" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].email || ''%><%} else if (form_values) { %><%= form_values.email || ''%><% } else {%><%= contact_email %><%}%>">
</div>

<input type="hidden" name="country" value="United Kingdom">
<input type="hidden" name="manual" value=false>
<input type="hidden" name="initial" value=<%if(initial){%><%= initial%><%}%>>

<input type="hidden" name="chosen_address" value=<%= chosen_address%>>
</div>

<div class="govuk-form-group">
  <button id="NextBtn" class="govuk-button">Continue</button>
</div>

</form>

<%- include('../partials/footer.ejs') %>
