
<% pageTitle ="Is return address UKs - Get a document legalised – GOV.UK" %>
<%if(error_report && error_report.length>0){
pageTitle = "Error: Is return address UK - Get a document legalised – GOV.UK"
} %>

<% locals.innerHeaderBackLink = '/api/user/addresses' %>
<%- include('../partials/header.ejs') %>

<% if (error_report && error_report.length > 0) { %>
  <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" aria-labelledby="error-summary-title" tabindex="-1" autofocus>
    <h2 class="govuk-error-summary__title" id="error-summary-title">
      There is a problem
    </h2>
    <div class="govuk-error-summary__body">
      <ul class="govuk-list govuk-error-summary__list">
        <li><a href="#radio-yes">Confirm whether the return address is in the UK</a></li>
      </ul>
    </div>
  </div>
<% } %>

<h1 class="heading-xlarge">Add a return address</h1>

<div class="govuk-form-group">
  <form id="is-uk" method="post" action="/api/user/add-address-uk?_csrf=<%=_csrf%>">

  <div class="govuk-form-group <% if (error_report && error_report.length > 0) { %>govuk-form-group--error<% } %>">
  <h2 class="govuk-label govuk-label--s">Is the return address in the UK?</h2>
  <% if (error_report && error_report.length > 0) { %>
    <p id="is-uk-error" class="govuk-error-message">
      <span class="govuk-visually-hidden">Error:</span> Confirm whether the return address is in the UK
    </p>
  <% } %>
  <fieldset class="inline" aria-required="true" role="radiogroup">
    <div class="govuk-radios govuk-radios--inline">
      <div class="govuk-radios__item">

        <input class="govuk-radios__input" id="radio-yes" type="radio" name="is_uk" value="true"
        <% if (error_report && error_report.length > 0) { %>aria-describedby="is-uk-error"<% } %>
        <% if(typeof (uk) != 'undefined' && uk){ %>checked="checked"
        <% } %>>
        <label class="govuk-radios__label <% if(typeof (uk) != 'undefined' && uk){ %>selected<% } %>"
        for="radio-yes">
        Yes
      </label>
    </div>

    <div class="govuk-radios__item">
      <input class="govuk-radios__input" id="radio-no" type="radio" name="is_uk" value="false"
      <% if (error_report && error_report.length > 0) { %>aria-describedby="is-uk-error"<% } %>
      <% if(typeof (uk) != 'undefined' && !uk && uk != null ){ %>checked="checked"
      <% } %>>
      <label class="govuk-radios__label <% if(typeof (uk) != 'undefined' && !uk && uk != null){ %>selected<% } %>"
      for="radio-no">

      No
    </label>
  </div>
</div>
</fieldset>
</div>

<div class="govuk-form-group">
  <button class="govuk-button" type="submit">Continue</button>
</div>

</form>
</div>

<%- include('../partials/footer.ejs') %>
