<% pageTitle = "Edit address - Get a document legalised – GOV.UK" %>
<%if(error_report && error_report.length>0){
pageTitle = "Error: Edit address - Get a document legalised – GOV.UK"
} %>

<% locals.innerHeaderBackLink = back_link != '' ? (url.applicationServiceURL + back_link) : '/api/user/addresses' %>
<%- include('../partials/header.ejs') %>

  <%
    var primaryAddressErrors = [];
    if (error_report) {
    if (error_report[0][0].errMsgs) {
    error_report[0][0].errMsgs.forEach(
    function(error){
    if (error.fieldName == "full_name") {
    primaryAddressErrors.push(error);
    }
    if (error.fieldName == "house_name") {
    primaryAddressErrors.push(error);
    }
    if (error.fieldName == "street") {
    primaryAddressErrors.push(error);
    }
    if (error.fieldName == "town") {
    primaryAddressErrors.push(error);
    }
    if (error.fieldName == "county") {
    primaryAddressErrors.push(error);
    }
    if (error.fieldName == "postcode") {
    primaryAddressErrors.push(error);
    }
    if (error.fieldName == "telephone") {
    primaryAddressErrors.push(error);
    }
    if (error.fieldName == "mobileNo") {
    primaryAddressErrors.push(error);
    }
    if (error.fieldName == "email") {
    primaryAddressErrors.push(error);
    }

    }
    )
    }

    }
  %>
  <%if(error_report.length>0){%><br>
<%}%>
<div class="govuk-error-summary <% if (error_report) { %>show<% } else { %>hide<% } %>" role="alert" aria-labelledby="error-summary-heading-example-2" tabindex="-1" autofocus>

<p class="govuk-error-summary__title" id="error-summary-heading-example-2">
  There is a problem
</p>

<div id="all-errors">
  <ul class="govuk-list govuk-error-summary__list">
    <% if (error_report) { %>
      <% error_report[0][0].errMsgs.forEach(function(errorMsgs) { %>
        <li>
          <% if (uk) { %>
            <a href="<%= errorMsgs.questionId === 'town-county' ? '#town' : '#' + errorMsgs.questionId %>">
            <%= errorMsgs.fieldSolution %>
          </a>
        <% } else { %>
            <a href="<%= errorMsgs.questionId === 'town-county' ? '#town' : '#' + errorMsgs.questionId %>">
            <%= errorMsgs.questionId === 'town-county' ? errorMsgs.fieldSolution.replace('county', 'region') : errorMsgs.fieldSolution.replace('postcode', 'zip code') %>
          </a>
        <% } %>
      </li>
    <% }) %>
  <% } %>
</ul>
</div>
</div>
<% if (require_contact_details === 'yes') {%>
  <h1 class="heading-xlarge">Update your saved address</h1>
<%}else{%>
    <h1 class="heading-xlarge">Edit return address</h1>
  <%}%>
  <form id="edit_address_form" method="post" action="/api/user/edit-address?_csrf=<%=_csrf%>">
  <fieldset class="govuk-fieldset" id="address-details-group">
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
      <h2 class="govuk-fieldset__heading">Address details</h2>
    </legend>

    <% if (require_contact_details === 'yes') {%>
      <p>To help ensure safe delivery to this address we need to confirm delivery contact information. Check the details below, make any changes, then continue with your application. We'll save the information in your account for next time. </p>
    <%}%>

    <div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('full_name')>-1) { %>govuk-form-group--error error<% } %>">
    <label class="govuk-label govuk-label--s" for="full_name">Full name</label>
    <span class="govuk-hint">Name of the person you would like the documents returned to</span>
    <input class="govuk-input govuk-!-width-one-half" id="full_name" type="text" aria-required="true" name="full_name" maxlength="255" value="<%if(form_values){%><%= form_values.full_name%><%}%>">
  </div>
  <div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('organisation')>-1) { %>govuk-form-group--error error<% } %>" id="legend_organisation">
  <label class="govuk-label govuk-label--s" for="organisation">Company or organisation (optional)</label>
  <input class="govuk-input govuk-!-width-one-half" id="organisation" type="text" name="organisation" aria-required="true" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].organisation%><%} else if (form_values) { %><%= form_values.organisation %><% } %>" >
</div>

<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('house_name')>-1) { %>govuk-form-group--error error<% } %>">
<label class="govuk-label govuk-label--s" for="house_name">House name or number</label>
<input class="govuk-input govuk-!-width-one-half" id="house_name" type="text" aria-required="true" maxlength="255" name="house_name" value="<%if(form_values && form_values.house_name && form_values.house_name != 'N/A') { %><%= form_values.house_name %><% } %>" >
</div>

<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('street')>-1) { %>govuk-form-group--error error<% } %>">
<label class="govuk-label govuk-label--s" for="street">Street</label>
<input class="govuk-input govuk-!-width-one-half" type="text" id="street" aria-required="true" maxlength="255" name="street" value="<%if(form_values){%><%= form_values.street%><%}%>" >
</div>

<div class="govuk-form-group <% if ((error_report && error_report[1][0].erroneousFields.indexOf('town-county')>-1) || (error_report && error_report[1][0].erroneousFields.indexOf('town')>-1)) { %>govuk-form-group--error error<% }%>">
<label class="govuk-label govuk-label--s" for="town">Town</label>
<input class="govuk-input govuk-!-width-one-half" type="text" id="town" aria-required="true" maxlength="255" name="town" value="<%if(form_values){%><%= form_values.town%><%}%>" >
</div>

<div class="govuk-form-group <% if ((error_report && error_report[1][0].erroneousFields.indexOf('town-county')>-1) || (error_report && error_report[1][0].erroneousFields.indexOf('county')>-1)) { %>govuk-form-group--error error<% } %>">
<label class="govuk-label govuk-label--s" for="county"><%if(uk){%>County<%}else{%>Region <span>(optional)</span><%}%></label>
<input class="govuk-input govuk-!-width-one-half" type="text" id="county" name="county" maxlength="255" value="<%if(form_values){%><%= form_values.county%><%}%>">
</div>

<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('postcode')>-1) { %>govuk-form-group--error error<% } %>">
<label class="govuk-label govuk-label--s" for="postcode"><%if(uk){%>Postcode<%}else{%>Zip Code <span>(optional)</span><%}%></label>
<input class="govuk-input govuk-!-width-one-quarter" id="postcode" aria-required="true" name="postcode" type="text" value="<%if(form_values){%><%= form_values.postcode%><%}%>" >
</div>

<div class="govuk-form-group">
  <label class="govuk-label govuk-label--s" for="country">Country</label>
  <select class="govuk-select govuk-!-width-one-half" aria-required="true" id="country" form="edit_address_form" name="country">
    <%for(var c=0; c<countries.length;c++){%>
      <option value="<%= countries[c].name%>" <%if ((form_values && form_values[0] && countries[c].name==form_values[0].country) || (form_values && countries[c].name==form_values.country)) { %>selected<%}%> >
      <%= countries[c].name%></option>

    <% } %>

  </select>
</div>
</fieldset>

<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('mobileNo')>-1) { %>govuk-form-group--error error<% } %>">
<label class="govuk-label govuk-label--s" for="mobileNo">Mobile number</label>
<span class="govuk-hint">Mobile number for this address for delivery questions or updates</span>
<input class="govuk-input govuk-!-width-one-half" type="tel" id="mobileNo" name="mobileNo" maxlength="255" value="<% if(form_values){%><%= form_values.mobileNo || ''%><%}%>" >
</div>

<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('telephone')>-1) { %>govuk-form-group--error error<% } %>">
<label class="govuk-label govuk-label--s" for="telephone">Secondary phone number <span>(optional)</span></label>
<span class="govuk-hint">Landline number for this address for delivery questions or updates</span>
<input class="govuk-input govuk-!-width-one-half" type="tel" id="telephone" aria-required="true" name="telephone" maxlength="255" value="<% if(form_values){%><%= form_values.telephone%><%}%>" >
</div>

<div class="govuk-form-group <% if (error_report && error_report[1][0].erroneousFields.indexOf('email')>-1) { %>govuk-form-group--error error<% } %>">
<label class="govuk-label govuk-label--s" for="email">Email address <span>(optional)</span></label>
<span class="govuk-hint">Contact email for this address for delivery questions or updates</span>
<input class="govuk-input govuk-!-width-one-half" type="text" id="email" name="email" maxlength="255" value="<% if (form_values){%><%= form_values.email || ''%><%}%>" >
</div>

<input type="hidden" name="address_id" value='<%= address_id%>'>
<div class="govuk-form-group">
  <button class="govuk-button">Save</button>
</div>
</form>

<%- include('../partials/footer.ejs') %>
